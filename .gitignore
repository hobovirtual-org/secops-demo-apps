# Terraform local cache and providers
.terraform/
.terraform.lock.hcl.bak

# State files — never commit
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Plan files — may contain sensitive data
*.tfplan

# Crash logs
crash.log
crash.*.log

# Override files — local use only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local variable files — may contain sensitive values
*.tfvars
*.auto.tfvars
!terraform.tfvars.example

# HCP Terraform CLI config
.terraformrc
terraform.rc

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Vault secrets — never commit
.secrets/
*.vault-token

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/

# Go
*.exe
*.test
*.out
vendor/

# Java
target/
*.class
*.jar
*.war
.gradle/

# Application secrets
.env
.env.*
!.env.example
