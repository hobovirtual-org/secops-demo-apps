project_name         = "demo"
environment          = "dev"
aws_region           = "us-east-1"
vault_address        = "https://vault.example.com"
vault_namespace      = "admin"
vpc_cidr             = "10.80.0.0/16"
public_subnet_cidrs  = ["10.80.1.0/24", "10.80.2.0/24"]
private_subnet_cidrs = ["10.80.10.0/24", "10.80.11.0/24"]
agent_prompt         = "Summarize the zero-trust security principles in 3 bullet points."
db_creds_ttl         = 3600
db_creds_max_ttl     = 14400

# No secrets to set — the Postgres admin password is generated automatically
# by random_password.postgres_admin and stored in AWS Secrets Manager.
